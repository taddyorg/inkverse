{
  "compilerOptions": {
    /* Base Options: */
    "esModuleInterop": true,
    "skipLibCheck": true,
    "target": "es2022",
    "resolveJsonModule": true,
    "moduleDetection": "force",
    "isolatedModules": true, // Keep if source files are used directly sometimes, otherwise remove
    "verbatimModuleSyntax": true,

    /* Strictness */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    /* Library Build */
    "module": "NodeNext", // Match graphql-server for consistency
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true, // Required for project references

    /* Module Resolution */
    "moduleResolution": "NodeNext",

    /* If your code doesn't run in the DOM: */
    "lib": ["es2022", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": ["src"], // Include all TS files in the src directory
  "exclude": ["node_modules", "dist"] // Exclude node_modules and the output dir
} 