{
  "name": "@inkverse/shared-server",
  "version": "1.0.0",
  "description": "Shared server code for Inkverse",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "rm -rf dist tsconfig.tsbuildinfo && tsc",
    "watch": "tsc --watch",
    "migrate": "tsx ./node_modules/.bin/knex --knexfile ./src/database/config.ts migrate:latest",
    "migrate:rollback": "tsx ./src/database/list-last-batch-migrations.ts",
    "migrate:list": "tsx ./node_modules/.bin/knex --knexfile ./src/database/config.ts migrate:list"
  },
  "author": "Inkverse",
  "license": "AGPL-3.0",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1155.0",
    "@aws-sdk/client-sesv2": "^3.1155.0",
    "@aws-sdk/client-sqs": "^3.1155.0",
    "@aws-sdk/lib-storage": "^3.1155.0",
    "@inkverse/public": "*",
    "@sentry/node": "^8.40.0",
    "axios": "^1.20.0",
    "dotenv": "^16.6.1",
    "expo-server-sdk": "^3.15.0",
    "graphql": "^16.14.2",
    "graphql-request": "^7.4.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.3.0",
    "knex-stringcase": "^1.6.0",
    "lodash-es": "^4.18.1",
    "moment": "^2.31.0",
    "moment-timezone": "^0.6.5",
    "pg": "^8.23.1",
    "redis": "^4.7.1",
    "uuid": "^11.1.1"
  },
  "optionalDependencies": {
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.19.2",
    "tsx": "^4.19.4",
    "typescript": "^5.7.2"
  }
}
